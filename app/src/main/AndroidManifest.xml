<!-- NFR-8 / ADR-0007: no INTERNET permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Portrait (docs/product/dive-lock-layout.md); singleTask as in the G1 platform test (ADR-0006). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- NFR-1 crash-restart trampoline: separate process, same task as MainActivity (ADR-0006). -->
        <activity
            android:name=".lock.RestartTrampolineActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:process=":restarter"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>
