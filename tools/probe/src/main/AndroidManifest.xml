<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to read all CameraCharacteristics keys and to query session support. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- ADR-0006 platform tests: heads-up notification, overlay (crash restart), do-not-disturb access. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <application
        android:allowBackup="false"
        android:label="Anomalops Probe"
        android:theme="@android:style/Theme.Material">

        <activity
            android:name=".ProbeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bench test of the FIR thermometer and other temperature sensors (docs/test/g0-blazer.md). -->
        <activity
            android:name=".FirLiveActivity"
            android:exported="true"
            android:label="Probe: temperature live" />

        <!-- Dive-lock platform behaviour test (ADR-0006). -->
        <activity
            android:name=".LockTestActivity"
            android:exported="true"
            android:label="Probe: lock test"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.tengigabytes.anomalops.probe.locktest" />

        <!-- Crash-restart trampoline: separate process, same task as LockTestActivity (ADR-0006, NFR-1). -->
        <activity
            android:name=".RestartTrampolineActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:process=":restarter"
            android:taskAffinity="io.github.tengigabytes.anomalops.probe.locktest"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>
