<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to read all CameraCharacteristics keys and to query session support. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="false"
        android:label="Anomalops Probe"
        android:theme="@android:style/Theme.Material">

        <activity
            android:name=".ProbeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bench test of the FIR thermometer and other temperature sensors (docs/test/g0-blazer.md). -->
        <activity
            android:name=".FirLiveActivity"
            android:exported="true"
            android:label="Probe: temperature live" />
    </application>

</manifest>
